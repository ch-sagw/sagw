# Server URL
NEXT_PUBLIC_SERVER_URL=

# Gumlet
NEXT_PUBLIC_GUMLET_URL=
GUMLET_API_TOKEN=
GUMLET_COLLECTION_ID=

# Payload
PAYLOAD_SECRET=

# Vercel blob
BLOB_READ_WRITE_TOKEN=
BLOB_URL=

# OVH MongoDB
DATABASE_NAME=
DATABASE_URI=

# Brevo
BREVO_TOKEN=

# Resend
RESEND_KEY=

# PDF generation token
PDF_GENERATION_SECRET=

# Tracking
NEXT_PUBLIC_TRACKING_SITE_ID=

# assets deletion
CRON_SECRET=

# assets deletion
# Base URL of the test environment, e.g. https://test.sagw.ch (with scheme,
# no trailing slash), normally identical to NEXT_PUBLIC_SERVER_URL above.
# not read by the app: it is only needed as a GitHub repository variable for
# the assets-cleanup-test workflow. listed here so it is not forgotten.
TEST_ENV_URL=

# Slack webhook to post into assets-deletion channel. optional locally:
# if set, `npm run assets:cleanup` posts [LOCAL] messages as well.
SLACK_WEBHOOK_URL_ASSETS_DELETE=
