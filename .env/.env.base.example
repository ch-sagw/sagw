# assets deletion: optional overrides of the per-tenant safety fuses
# (defaults: 25 percent, 50 assets). only for exceptional runs such as
# the initial cleanup, remove them afterwards. see docs/assets-cleanup.md.
ASSETS_CLEANUP_MAX_DELETE_PERCENT=
ASSETS_CLEANUP_MAX_DELETE_ABSOLUTE=
